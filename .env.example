APP_NAME=PulseDesk
ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://pulsedesk:pulsedesk@localhost:5432/pulsedesk
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# "mock" uses the deterministic rule-based fallback (no external calls, no cost).
# Set to "openai" or "anthropic" and provide LLM_API_KEY once you have one.
LLM_PROVIDER=mock
LLM_API_KEY=

DEFAULT_SLA_HOURS=24
RATE_LIMIT_PER_MINUTE=60
