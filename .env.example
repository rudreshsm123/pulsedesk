APP_NAME=PulseDesk
ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://pulsedesk:pulsedesk@localhost:5432/pulsedesk
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-min-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# "mock" uses the deterministic rule-based/extractive fallback (no external calls, no
# cost, cannot hallucinate). Set to "anthropic" and provide LLM_API_KEY to use a real
# model -- get a key from console.anthropic.com (Settings -> API Keys), never commit it.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_CLASSIFY_MODEL=claude-haiku-4-5-20251001
LLM_RESOLUTION_MODEL=claude-sonnet-5

DEFAULT_SLA_HOURS=24
RATE_LIMIT_PER_MINUTE=60
