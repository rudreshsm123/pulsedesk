APP_NAME=PulseDesk
ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://pulsedesk:pulsedesk@localhost:5432/pulsedesk
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-min-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# "mock" uses the deterministic rule-based/extractive fallback (no external calls, no
# cost, cannot hallucinate). Set to "anthropic" (console.anthropic.com, paid) or "groq"
# (console.groq.com, free tier) and provide LLM_API_KEY to use a real model -- never
# commit the key. LLM_CLASSIFY_MODEL/LLM_RESOLUTION_MODEL are optional: each provider
# has a sensible default (see app/services/llm/factory.py) if left unset.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_CLASSIFY_MODEL=
LLM_RESOLUTION_MODEL=

DEFAULT_SLA_HOURS=24
RATE_LIMIT_PER_MINUTE=60
